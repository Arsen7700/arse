# Local development (SQLite). For Render, set DATABASE_URL to the PostgreSQL URL
# from the Render database dashboard; do not commit the real value.
DATABASE_URL=sqlite:///./inventory.db
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_KEY=
# Telegram numeric user IDs allowed to access production data, comma-separated.
TELEGRAM_ALLOWED_USER_IDS=
